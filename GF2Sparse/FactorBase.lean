import GF2Sparse.OrderBound
import GF2Sparse.Roots
import GF2Sparse.PackedOrder

/-! Count a family of reduced rational functions in the subgroup generated by X. -/

namespace GF2Sparse

open Polynomial

/-- Distinct rational functions stay distinct at the root when their cross products
have degree below the modulus. Their numerator and denominator logarithms then bound its order. -/
theorem order_ge_of_fraction_family {ι : Type*} [Fintype ι] {f : BinaryPoly}
    (hc : f.coeff 0 = 1) (a b : ι → BinaryPoly) (u v : ι → ℕ)
    (hcross : ∀ i j, a i * b j = a j * b i → i = j)
    (hsmall : ∀ i j, (a i * b j).natDegree < f.natDegree)
    (ha : ∀ i, AdjoinRoot.mk f (a i) = AdjoinRoot.root f ^ u i)
    (hb : ∀ i, AdjoinRoot.mk f (b i) = AdjoinRoot.root f ^ v i) :
    Fintype.card ι ≤ orderOf (AdjoinRoot.root f) := by
  classical
  have hf : f ≠ 0 := by rintro rfl; simp at hc
  let r := AdjoinRoot.root f
  let h := orderOf r
  let eqv := (AdjoinRoot.powerBasisAux hf).equivFun.toEquiv
  letI : Fintype (AdjoinRoot f) := Fintype.ofEquiv _ eqv.symm
  letI : NeZero h := ⟨(root_unit hc).isOfFinOrder.orderOf_pos.ne'⟩
  let logRatio (i : ι) : ZMod h := (u i : ZMod h) - (v i : ZMod h)
  have inj : Function.Injective logRatio := by
    intro i j hij
    have he : ((u i + v j : ℕ) : ZMod h) = ((u j + v i : ℕ) : ZMod h) := by
      push_cast
      exact sub_eq_sub_iff_add_eq_add.1 hij
    have hm := (ZMod.natCast_eq_natCast_iff' _ _ _).1 he
    apply hcross i j
    apply eq_of_sub_eq_zero
    by_contra hne
    apply AdjoinRoot.mk_ne_zero_of_natDegree_lt (binary_monic hf) hne
      ((natDegree_sub_le _ _).trans_lt (max_lt (hsmall i j) (hsmall j i)))
    rw [map_sub, sub_eq_zero]
    simp only [map_mul, ha, hb, ← pow_add]
    exact (pow_mod_orderOf r _).symm.trans
      ((congrArg (fun k : ℕ => r^k) hm).trans (pow_mod_orderOf r _))
  simpa [h, r, ZMod.card] using Fintype.card_le_of_injective logRatio inj

/-- A lower bound on the order only requires prime-factor tests up to the remaining index. -/
theorem primitive_of_bounded_index {f : BinaryPoly} (hf : f.Monic) (hn : 0 < f.natDegree)
    {J : ℕ} (hfull : AdjoinRoot.root f ^ (2^f.natDegree-1) = 1)
    (hbound : 2^f.natDegree-1 < orderOf (AdjoinRoot.root f) * J)
    (hexclude : ∀ p : ℕ, p.Prime → p ∣ 2^f.natDegree-1 → p < J →
      AdjoinRoot.root f ^ ((2^f.natDegree-1)/p) ≠ 1) : Primitive f := by
  let r := AdjoinRoot.root f
  let M := 2^f.natDegree-1
  have hM : 0 < M := Nat.sub_pos_of_lt (Nat.one_lt_two_pow hn.ne')
  obtain ⟨i,hi⟩ := orderOf_dvd_of_pow_eq_one hfull
  change M = orderOf r * i at hi
  have hi0 : i ≠ 0 := by rintro rfl; simp_all
  apply primitive_of_order hf hn
  change orderOf r = M
  by_contra hne
  have hi1 : i ≠ 1 := by rintro rfl; simp_all
  obtain ⟨p,hp,hpi⟩ := Nat.exists_prime_and_dvd hi1
  have hlt : i < J := by
    change M < orderOf r * J at hbound
    rw [hi] at hbound
    exact Nat.lt_of_mul_lt_mul_left hbound
  have hd : p ∣ M := hi ▸ hpi.trans (dvd_mul_left _ _)
  apply hexclude p hp hd ((Nat.le_of_dvd (Nat.pos_of_ne_zero hi0) hpi).trans_lt hlt)
  change r ^ (M / p) = 1
  rw [hi, Nat.mul_div_assoc _ hpi, pow_mul, pow_orderOf_eq_one, one_pow]

end GF2Sparse
