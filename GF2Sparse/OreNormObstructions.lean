import GF2Sparse.FrobeniusWitness
import GF2Sparse.OreLift

/-! Generated by scripts/make_ore_index_witnesses.py. Each mask represents
a seventh root of X in the degree-4095 quotient. -/

namespace GF2Sparse

open Polynomial

set_option maxRecDepth 32768
set_option maxHeartbeats 1000000

private def certificates : List ((ℕ × ℕ × ℕ) × ℕ) := [
  ((1, 4, 6), ),
  ((1, 5, 8), ),
  ((2, 7, 8), ),
  ((4, 5, 10), ),
  ((4, 7, 11), ),
  ((6, 8, 11), )]

private def liftMask (a b c : ℕ) : ℕ := fiveTermMask 4095 (2^c-1) (2^b-1) (2^a-1)

private theorem ore_five (s c b a : ℕ) : oreLift (decode (fiveTermMask s c b a)) =
    decode (fiveTermMask (2^s-1) (2^c-1) (2^b-1) (2^a-1)) := by
  simp only [decode_fiveTermMask, oreLift_add, oreLift_X_pow, oreLift_one]

private def checks (row : (ℕ × ℕ × ℕ) × ℕ) : Bool :=
  let (a,b,c) := row.1
  let w := row.2
  let f := liftMask a b c
  check 12 (fiveTermMask 12 c b a) [3,3,5,7,13] &&
    f.log2 == 4095 && w != 0 && decide (w.log2 < 4095) && frobeniusPowerCheck 3 4095 f w 32 [4095,2^c-1,2^b-1,2^a-1,0]

private theorem verified : certificates.all checks = true := by decide +kernel

set_option exponentiation.threshold 4095 in
/-- The six listed primitive seeds give irreducible degree-4095 lifts with a missing factor of seven. -/
theorem ore_degree_twelve_missing_seven (a b c : ℕ)
    (hs : (a,b,c) ∈ [(1, 4, 6), (1, 5, 8), (2, 7, 8), (4, 5, 10), (4, 7, 11), (6, 8, 11)]) :
    let P := decode (fiveTermMask 12 c b a)
    Primitive P ∧ Irreducible (oreLift P) ∧
      orderOf (AdjoinRoot.root (oreLift P)) ∣ (2^4095-1)/7 := by
  have hmem : (a,b,c) ∈ certificates.map Prod.fst := hs
  obtain ⟨⟨t,w⟩, hin, ht⟩ := List.mem_map.1 hmem
  change t = (a,b,c) at ht
  subst t
  have h := List.all_eq_true.1 verified _ hin
  simp only [checks, Bool.and_eq_true, beq_iff_eq, bne_iff_ne, decide_eq_true_eq] at h
  have hp := (check_sound (by
    intro p h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with rfl | rfl | rfl | rfl | rfl <;> decide) h.1.1.1.1).2.2
  refine ⟨hp, hp.irreducible_oreLift, ?_⟩
  have he : oreLift (decode (fiveTermMask 12 c b a)) = decode (liftMask a b c) := by
    simpa only [liftMask, show 2^12-1 = 4095 by decide] using ore_five 12 c b a
  rw [he]
  exact order_dvd_of_frobeniusPowerCheck (d := 3) (n := 4095) (he ▸ hp.irreducible_oreLift) h.1.1.1.2
    h.1.1.2 h.1.2 (by decide +kernel) h.2

end GF2Sparse
