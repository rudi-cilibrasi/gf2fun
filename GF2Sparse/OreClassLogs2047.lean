def seed (reverse : Bool) : ℕ := if reverse then 0xa01 else 0x805

def tap (reverse : Bool) : ℕ := if reverse then 511 else 3

def seedLog (reverse : Bool) (g : ℕ) : ℕ :=
  match seedLogs.find? (fun row => row.1 == g) with
  | some row => if reverse then row.2.2 else row.2.1
  | none => 0

theorem class_count : classes.length = 47 ∧ (classes.map Prod.fst).Nodup := by
  decide +kernel

private def verified (reverse : Bool) := classes.all fun row =>
  check 11 (seed reverse) (seedLog reverse) row.1 row.2.1 row.2.2

set_option maxRecDepth 16384 in
set_option maxHeartbeats 2000000 in
private theorem checked : ∀ reverse : Bool, verified reverse = true := by decide +kernel

private theorem lift_eq (reverse : Bool) :
    oreLift (decode (seed reverse)) = trinomial 2047 (tap reverse) := by
  have shape (a : ℕ) : oreLift (decode (2^11 ^^^ (2^a ^^^ 1))) =
      trinomial (2^11-1) (2^a-1) := by
    simp only [decode_xor, decode_one, decode_pow_two, oreLift_add, oreLift_X_pow,
      oreLift_one, trinomial]
  cases reverse
  · exact shape 2
  · exact shape 9

/-- Each published polynomial mask has this signed logarithm at every root of
the corresponding trinomial, over any field extending the binary field. -/
theorem logarithm {K : Type*} [Field K] [Algebra (ZMod 2) K] (reverse : Bool) {z : K}
    (hz : aeval z (trinomial 2047 (tap reverse)) = 0)
    {row : ℕ × List ℕ × List ℕ} (hr : row ∈ classes) :
    aeval z (decode row.1) = z^(exponent (seedLog reverse) row.2.1) /
      z^(exponent (seedLog reverse) row.2.2) := by
  have hn : z ≠ 0 := by
    rintro rfl
    cases reverse <;> simp [tap, trinomial] at hz
  apply check_sound ((lift_eq reverse).symm ▸ hz) hn
  exact List.all_eq_true.1 (checked reverse) row hr

