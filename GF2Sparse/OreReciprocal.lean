import GF2Sparse.OreLift
import Mathlib.Algebra.Polynomial.Reverse

/-! Reversing a binary seed preserves the multiplicative subgroup generated by its lifted roots. -/

namespace GF2Sparse

open Polynomial

private abbrev K := AlgebraicClosure (ZMod 2)
private noncomputable abbrev a (p : BinaryPoly) (i : ℕ) : K := algebraMap (ZMod 2) K (p.coeff i)

private theorem coeff_sq (p : BinaryPoly) (i : ℕ) : (a p i)^2 = a p i := by
  have h : ∀ c : ZMod 2, c^2 = c := by decide
  rw [← map_pow, h]

private theorem ore_eval_sum (p : BinaryPoly) (z : K) :
    aeval z (oreLift p) = ∑ i ∈ Finset.range (p.natDegree+1), a p i * z^(2^i-1) := by
  rw [aeval_def, eval₂_eq_sum, sum_def, oreLift_support, Finset.sum_map]
  change (∑ i ∈ p.support, algebraMap (ZMod 2) K ((oreLift p).coeff (2^i-1)) * z^(2^i-1)) = _
  simp_rw [oreLift_coeff]
  apply Finset.sum_subset (fun i hi => Finset.mem_range.2 (by have := le_natDegree_of_mem_supp _ hi; omega))
  intro i _ hi
  simp [notMem_support_iff.1 hi]

private noncomputable def b (p : BinaryPoly) (z : K) : ℕ → K
  | 0 => 0
  | j+1 => z * ((b p z j)^2 + a p j)

private theorem b_sum (p : BinaryPoly) (z : K) (t : ℕ) :
    b p z t = ∑ i ∈ Finset.range t, a p (t-1-i) * z^(2^(i+1)-1) := by
  induction t with
  | zero => simp [b]
  | succ t ih =>
    rw [b, ih, sum_pow_char, mul_add, Finset.mul_sum, Finset.sum_range_succ' (n := t)]
    congr 1
    · apply Finset.sum_congr rfl
      intro i hi
      have hpos := Nat.two_pow_pos (i+1)
      have he : 2^(i+1+1)-1 = (2^(i+1)-1)*2+1 := by rw [pow_succ 2 (i+1)]; omega
      have hj : t+1-1-(i+1) = t-1-i := by omega
      rw [mul_pow, coeff_sq, ← pow_mul, hj, he, pow_succ z _]
      ring
    · simp; ring

private noncomputable def part (p : BinaryPoly) (z x : K) (t : ℕ) : K :=
  ∑ j ∈ Finset.range t, b p z (j+1) * x^(2^j)

private theorem part_identity (p : BinaryPoly) (z x : K) (hz : z ≠ 0) (t : ℕ) :
    (part p z x t)^2 - part p z x t / z =
      (b p z t)^2 * x^(2^t) - ∑ i ∈ Finset.range t, a p i * x^(2^i) := by
  induction t with
  | zero => simp [part, b]
  | succ t ih =>
    have step : part p z x (t+1) = part p z x t + b p z (t+1)*x^(2^t) := Finset.sum_range_succ ..
    have hc : b p z (t+1)*x^(2^t)/z = ((b p z t)^2 + a p t)*x^(2^t) := by
      rw [b]; field_simp
    have hx : (x^(2^t))^2 = x^(2^(t+1)) := by rw [← pow_mul, pow_succ]
    rw [step, CharTwo.add_sq, add_div, hc, mul_pow, hx, Finset.sum_range_succ]
    linear_combination ih

private noncomputable def factorPoly (p : BinaryPoly) (z : K) (t : ℕ) : K[X] :=
  ∑ j ∈ Finset.range t, C (b p z (j+1)) * X^(oreIndex j)

private theorem factor_coeff (p : BinaryPoly) (z : K) {j t : ℕ} (hj : j < t) :
    (factorPoly p z t).coeff (oreIndex j) = b p z (j+1) := by
  simp only [factorPoly, finset_sum_coeff, coeff_C_mul_X_pow, EmbeddingLike.apply_eq_iff_eq]
  simp [Finset.mem_range.2 hj]

private theorem factor_monic (p : BinaryPoly) (z : K) (t : ℕ) (ht : b p z (t+1) = 1) :
    (factorPoly p z (t+1)).Monic := by
  apply monic_of_degree_le (oreIndex t) _ ((factor_coeff p z (Nat.lt_succ_self t)).trans ht)
  apply (degree_sum_le _ _).trans (Finset.sup_le ?_)
  intro i hi
  apply (degree_C_mul_X_pow_le _ _).trans
  have h := Nat.pow_le_pow_right (by decide : 0 < 2) (Nat.le_of_lt_succ (Finset.mem_range.1 hi))
  exact WithBot.coe_le_coe.2 (show 2^i-1 ≤ 2^t-1 by omega)

private theorem mul_factor_eval (p : BinaryPoly) (z x : K) (t : ℕ) :
    x * (factorPoly p z t).eval x = part p z x t := by
  simp only [factorPoly, eval_finset_sum, eval_mul, eval_C, eval_pow, eval_X, Finset.mul_sum, part]
  apply Finset.sum_congr rfl
  intro i _
  change x * (_ * x^(2^i-1)) = _ * x^(2^i)
  rw [mul_left_comm, ← pow_succ', Nat.sub_add_cancel (Nat.two_pow_pos i)]

private theorem reverse_degree {p : BinaryPoly} (hc : p.coeff 0 = 1) :
    p.reverse.natDegree = p.natDegree := by
  rw [reverse_natDegree, natTrailingDegree_eq_zero.2 (Or.inr (hc ▸ one_ne_zero)), Nat.sub_zero]

private theorem reverse_constant {p : BinaryPoly} (hc : p.coeff 0 = 1) : p.reverse.coeff 0 = 1 := by
  rw [coeff_zero_reverse]
  exact (binary_monic (show p ≠ 0 by intro he; simp [he] at hc)).leadingCoeff

private theorem rev_invol {p : BinaryPoly} (hc : p.coeff 0 = 1) : p.reverse.reverse = p := by
  change reflect p.reverse.natDegree (reflect p.natDegree p) = p
  rw [reverse_degree hc, reflect_reflect]

private theorem reciprocal_eval (p : BinaryPoly) (z : K) (hc : p.coeff 0 = 1) :
    aeval z (oreLift p.reverse) = b p z p.natDegree + 1 := by
  rw [ore_eval_sum, reverse_degree hc, Finset.sum_range_succ', b_sum]
  congr 1
  · apply Finset.sum_congr rfl
    intro i hi
    have hle : i+1 ≤ p.natDegree := Finset.mem_range.1 hi
    simp only [a, coeff_reverse, revAt_le hle]
    rw [show p.natDegree-(i+1)=p.natDegree-1-i by omega]
  · simp [a, reverse_constant hc]

private theorem mul_ore_eval (p : BinaryPoly) (x : K) :
    x * aeval x (oreLift p) = ∑ i ∈ Finset.range (p.natDegree+1), a p i * x^(2^i) := by
  rw [ore_eval_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [mul_left_comm, ← pow_succ', Nat.sub_add_cancel (Nat.two_pow_pos i)]

/-- Every root of the reciprocal seed's lift is a product of roots of the original lift. -/
theorem oreLift_reverse_root_product {p : BinaryPoly} (hs : 0 < p.natDegree) (hc : p.coeff 0 = 1)
    {z : AlgebraicClosure (ZMod 2)} (hz : aeval z (oreLift p.reverse) = 0) :
    ∃ w : Multiset (AlgebraicClosure (ZMod 2)), w.prod = z ∧ ∀ x ∈ w, aeval x (oreLift p) = 0 := by
  classical
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [← coeff_zero_eq_aeval_zero', oreLift_constant, reverse_constant hc, map_one] at hz
    exact one_ne_zero hz
  obtain ⟨t, ht⟩ : ∃ t, p.natDegree = t+1 := ⟨p.natDegree-1, by omega⟩
  have htop : b p z (t+1) = 1 := by
    rw [reciprocal_eval p z hc, ht] at hz
    simpa only [CharTwo.neg_eq] using eq_neg_of_add_eq_zero_left hz
  have pm := binary_monic (show p ≠ 0 by intro he; simp [he] at hc)
  have hlead : a p (t+1) = 1 := by simp [a, ← ht, pm.coeff_natDegree]
  let g := factorPoly p z (t+1)
  have gm : g.Monic := factor_monic p z t htop
  have g0 : g.coeff 0 = z := by
    change (factorPoly p z (t+1)).coeff (oreIndex 0) = z
    rw [factor_coeff p z (Nat.zero_lt_succ t)]
    simp [b, a, hc]
  have hprod := (IsAlgClosed.splits g).coeff_zero_eq_prod_roots_of_monic gm
  refine ⟨g.roots, (by simpa [g0, CharTwo.neg_eq] using hprod.symm), fun x hx => ?_⟩
  have hroot := (mem_roots gm.ne_zero).1 hx
  change g.eval x = 0 at hroot
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [← coeff_zero_eq_eval_zero, g0] at hroot
    exact hz0 hroot
  have hv : part p z x (t+1) = 0 := by rw [← mul_factor_eval, hroot, mul_zero]
  have hsum := part_identity p z x hz0 (t+1)
  rw [hv, htop, zero_pow (by decide : 2 ≠ 0), zero_div, sub_zero, one_pow, one_mul] at hsum
  apply (mul_eq_zero.1 ?_).resolve_left hx0
  rw [mul_ore_eval, ht, Finset.sum_range_succ, ← sub_eq_zero.1 hsum.symm, hlead, one_mul,
    CharTwo.add_self_eq_zero]

/-- The multiplicative submonoid generated by all lifted roots is invariant under reversal. -/
theorem oreLift_reverse_root_closure {p : BinaryPoly} (hs : 0 < p.natDegree) (hc : p.coeff 0 = 1) :
    Submonoid.closure {z : AlgebraicClosure (ZMod 2) | aeval z (oreLift p.reverse) = 0} =
    Submonoid.closure {z : AlgebraicClosure (ZMod 2) | aeval z (oreLift p) = 0} := by
  have incl {q : BinaryPoly} (hd : 0 < q.natDegree) (h0 : q.coeff 0 = 1) :
      Submonoid.closure {z : K | aeval z (oreLift q.reverse) = 0} ≤
        Submonoid.closure {z : K | aeval z (oreLift q) = 0} := by
    apply Submonoid.closure_le.2
    intro z hz
    obtain ⟨w, rfl, hw⟩ := oreLift_reverse_root_product hd h0 hz
    exact multiset_prod_mem w fun x hx => Submonoid.subset_closure (hw x hx)
  apply le_antisymm (incl hs hc)
  simpa only [rev_invol hc] using incl ((reverse_degree hc).symm ▸ hs) (reverse_constant hc)

end GF2Sparse
